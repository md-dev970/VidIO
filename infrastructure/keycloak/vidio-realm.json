{
  "realm": "vidio",
  "enabled": true,
  "registrationAllowed": true,
  "registrationEmailAsUsername": true,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "verifyEmail": true,
  "resetPasswordAllowed": true,
  "defaultRoles": ["USER"],
  "smtpServer": {
    "host": "${VIDIO_SMTP_HOST}",
    "port": "${VIDIO_SMTP_PORT}",
    "from": "${VIDIO_SMTP_FROM}",
    "fromDisplayName": "VidIO",
    "auth": "${VIDIO_SMTP_AUTH}",
    "ssl": "false",
    "starttls": "${VIDIO_SMTP_STARTTLS}",
    "user": "${VIDIO_SMTP_USER}",
    "password": "${VIDIO_SMTP_PASSWORD}"
  },
  "roles": {
    "realm": [
      { "name": "USER" },
      { "name": "ADMIN" }
    ]
  },
  "clients": [
    {
      "clientId": "vidio-dashboard",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "redirectUris": [
        "http://localhost:4200/*",
        "http://localhost:8088/*",
        "/*",
        "*"
      ],
      "webOrigins": [
        "http://localhost:4200",
        "http://localhost:8088",
        "+"
      ]
    }
  ],
  "users": [
    {
      "username": "admin",
      "enabled": true,
      "emailVerified": true,
      "email": "admin@vidio.local",
      "firstName": "Admin",
      "lastName": "User",
      "credentials": [
        {
          "type": "password",
          "value": "admin123",
          "temporary": false
        }
      ],
      "realmRoles": ["USER", "ADMIN"]
    },
    {
      "username": "user1",
      "enabled": true,
      "emailVerified": true,
      "email": "user1@vidio.local",
      "firstName": "User",
      "lastName": "One",
      "credentials": [
        {
          "type": "password",
          "value": "user123",
          "temporary": false
        }
      ],
      "realmRoles": ["USER"]
    },
    {
      "username": "user2",
      "enabled": true,
      "emailVerified": true,
      "email": "user2@vidio.local",
      "firstName": "User",
      "lastName": "Two",
      "credentials": [
        {
          "type": "password",
          "value": "user123",
          "temporary": false
        }
      ],
      "realmRoles": ["USER"]
    }
  ]
}
